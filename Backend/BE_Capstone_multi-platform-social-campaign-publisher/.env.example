# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (docker-compose service name "postgres")
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://campaign_user:campaign_pass@postgres:5432/campaign_publisher?schema=public

# ---------------------------------------------------------------------------
# Redis / BullMQ (docker-compose service name "redis")
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# Security
# ENCRYPTION_KEY must be 32 raw bytes, base64-encoded (44 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WEBHOOK_SECRET is the shared HMAC secret with the fake platform.
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SHARED_SECRET

# ---------------------------------------------------------------------------
# Fake social platform (separate service, see fake-platform/)
# ---------------------------------------------------------------------------
FAKE_PLATFORM_BASE_URL=http://fake-platform:4000
FAKE_PLATFORM_WEBHOOK_TARGET_URL=http://api:3000/webhook/social-delivery

# ---------------------------------------------------------------------------
# Optional AI caption generation. If unset, the app uses deterministic local
# template composition (see src/application/campaigns/compose-caption.ts).
# ---------------------------------------------------------------------------
AI_PROVIDER=none
AI_API_KEY=
AI_MONTHLY_BUDGET_USD=5

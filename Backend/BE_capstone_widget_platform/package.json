{
  "name": "flyrank-capstone-widget-platform",
  "version": "1.0.0",
  "description": "Embeddable Widget & Lead-Capture Platform — FlyRank Internship Backend Track Capstone",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "test": "NODE_ENV=test jest --runInBand",
    "test:watch": "NODE_ENV=test jest --watch",
    "test-site": "npx --yes serve test-site -l 5500",
    "db:reset": "rm -f data/*.sqlite && node -e \"require('./src/db/init')()\""
  },
  "keywords": ["widget", "lead-capture", "embeddable", "express", "capstone"],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
